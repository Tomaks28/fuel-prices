{
  "name": "@tomaks28/fuel-prices",
  "version": "0.0.0",
  "description": "TypeScript SDK returning fuel prices of French gas stations, backed by official open data",
  "keywords": [
    "fuel",
    "prices",
    "gas-station",
    "carburant",
    "opendata",
    "france",
    "sdk"
  ],
  "license": "MIT",
  "author": "Tomaks28",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tomaks28/fuel-prices.git"
  },
  "bugs": {
    "url": "https://github.com/Tomaks28/fuel-prices/issues"
  },
  "homepage": "https://github.com/Tomaks28/fuel-prices#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:verify": "tsdown --publint --attw --fail-on-warn",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0"
  }
}
